{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "RelAudio ana pencere izinleri",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-set-focus",
    "core:window:allow-unminimize",
    "core:event:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "https://buymeacoffee.com/bbesli" },
        { "url": "https://github.com/bbesli/RelAudio" },
        { "url": "https://github.com/bbesli/RelAudio/*" }
      ]
    }
  ]
}
